# ─── Database (Neon, created by Vercel → Storage → Neon) ─────────────────────
DATABASE_URL=

# ─── File storage (Vercel → Storage → Blob) ──────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── Admin login (Auth.js + Google) ───────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# The only Google account allowed into /admin
ADMIN_EMAIL=
# Only needed locally with `next start` (Vercel and `next dev` trust the host automatically)
# AUTH_TRUST_HOST=true

# ─── Comments captcha (Cloudflare Turnstile) ─────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random secret used to hash visitor IPs (rate limiting without storing IPs)
IP_HASH_SALT=

# ─── Email (SMTP, already used by the contact form) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
EMAIL_CC=

# ─── Contentful (only until the migration is finished) ───────────────────────
CONTENTFUL_ID_SPACE=
CONTENTFUL_ACCESS_TOKEN=
